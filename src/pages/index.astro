---
import '../styles/global.css';
import { client } from '../lib/microcms';

type News = {
  id: string;
  title: string;
  date: string;
  category: string;
  body: string;
};
type Race = {
  title: string;
  date: string;
  venue: string;
  description: string;
  entryUrl?: string;
  entryStatus?: string[];
  schedule?: string;
  access?: string;
  mapUrl?: string;
};

const { contents: news } = await client.getList<News>({
  endpoint: 'news',
  queries: {
    limit: 3,
    orders: '-date',
  },
});

const race = await client.getObject<Race>({
  endpoint: 'race',
});
---


<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>AWA CYCLOCROSS</title>
  <meta
    name="description"
    content="徳島で開催される阿波シクロクロス。"
  />
</head>

<body>
  <header class="header">
    <nav class="nav">
      <a class="brand" href="/">
        <span class="mark">AWA</span>
        <span>AWA CYCLOCROSS</span>
      </a>

      <div class="navlinks">
        <a href="/race">RACE</a>
        <a href="/about">ABOUT CX</a>
        <a href="/news">NEWS</a>
        <a href="/race#entry">ENTRY</a>
      </div>
    </nav>
  </header>

  <main>
    <section class="hero">

<div class="hero-art">
  <img src="/awa-logo.png" alt="AWA CYCLOCROSS ロゴ">
</div>
    </section>


<section class="next" id="race">
  <div class="next-inner">
    <div class="next-content">
      <small>NEXT RACE / 2026–27 SEASON</small>

      <h2 class="next-date">
        {new Date(race.date).toLocaleDateString('ja-JP', {
          timeZone: 'Asia/Tokyo',
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
        }).replaceAll('/', '.')}
      </h2>

      <strong class="next-title">{race.title}</strong>

      <p class="next-venue">{race.venue}</p>
    </div>

    <a class="cta" href="/race">
      RACE INFO →
    </a>
  </div>
</section>

    <section class="section" id="news">
      <div class="section-head">
        <h2>NEWS</h2>
        <a class="more" href="/news">ALL NEWS →</a>
      </div>

      <div class="news">
        {news.map((item) => (
          <article class="news-card">
            <div>
              <span class="date">
  {new Date(item.date).toLocaleDateString('ja-JP', {
    timeZone: 'Asia/Tokyo',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).replaceAll('/', '.')}
</span>
              <span class="tag">{item.category}</span>
            </div>

<div class="news-title">
  <a href={`/news/${item.id}/`}>{item.title}</a>
</div>
</article>
))}
</div>
</section>



<section class="section" id="about">
  <div class="section-head">
    <h2>LINKS</h2>
  </div>

  <p class="about-text">
    岡山・四国、関西のシクロクロス大会
  </p>

  <div class="nearby-races">
    <a href="https://kansaicross.com" class="race-link">関西シクロクロス ↗</a>
    <a href="https://shikoku-cyclocross.com" class="race-link">岡山・四国シクロクロス ↗</a>
  </div>
</section>

  </main>

  <footer class="footer">
    <div class="footer-inner">
      <div>
        <h2>AWA CYCLOCROSS</h2>
        <p>© 2026 AWA CYCLOCROSS</p>
      </div>

      <div class="footer-links">
  <a
    href="https://www.facebook.com/awacyclocross?locale=ja_JP"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Facebook"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.51 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z"/>
    </svg>
    <span>FACEBOOK</span>
  </a>

  <a href="mailto:awacyclocross@gmail.com">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="2"/>
      <path d="m3 7 9 6 9-6"/>
    </svg>
    <span>CONTACT</span>
  </a>
</div>
    </div>
  </footer>
</body>
</html>

<style>

  .hero {
    max-width: 1180px;
    margin: 0 auto;
    padding: 16px 28px;
    display: flex;
    justify-content: center;
    align-items: center;
  }


  h1,
  h2,


.hero-art {
  min-height: 0;
  position: relative;
  background: transparent;
  overflow: hidden;
}


  .next {
    border-top: 3px solid #719985;
    border-bottom: none;
    background: #193f49;
    color: #ffffff;
  }

  .next-inner {
    background transparent;
    max-width: 1180px;
    margin: auto;
    padding: 28px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 30px;
    align-items: center;
  }

  .next small {
    display: block;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-hight: 1.5;
  }


.next .next-title {
  display: block;
  margin-top: 4px;
  font-size: clamp(18px, 2vw, 24px);
  font-weight: 700;
  line-height: 1.5;
  color: #ffffff;
}

.next .next-venue {
  margin: 12px 0 0;
  font-size: 14px;
  line-height: 1.7;
  color: #d5e2e3;
}


.next .next-date {
  margin: 8px 0 12px;
  font-size: clamp(32px, 4vw, 52px);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.03em;
  color: #ffffff;
}


.next .cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14px 24px;
  border: 1px solid #ffffff;
  background: transparent;
  color: #ffffff;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-decoration: none;
  white-space: nowrap;
  transition: background 0.2s, color 0.2s;
}

.next .cta:hover {
  background: #ffffff;
  color: #193f49;
}


  .section {
    max-width: 1180px;
    margin: auto;
    padding: 92px 28px;
  }

  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 34px;
  }

  .section-head h2 {
    font-size: clamp(38px, 5vw, 62px);
    color: #173f46;
  }

  .more {
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.12em;
    border-bottom: 1px solid #173f46;
    padding-bottom: 4px;
  }

.news {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1px;
  background: #d8d9d2;
  border: 1px solid #719985;
}

.news-card {
  background: #f5f3ec;
  padding: 24px 28px;
  min-height: 120px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

  .date {
    font-size: 12px;
    color: #456b60;
    letter-spacing: 0.08em;
    font-weight: 700;
    line-height: 1.5;
  }

  .tag {
    font-size: 10px;
    letter-spacing: 0.12em;
    font-weight: 900;
    color: #2f6f78;
    margin-left: 10px;
  }

  .news-title {
    font-size: 25px;
    font-weight: 900;
    line-height: 1.25;
  }


  .about-text {
    max-width: 720px;
    font-size: 20px;
  }

  .footer {
    background: #173f46;
    color: white;
  }

  .footer-inner {
    max-width: 1180px;
    margin: auto;
    padding: 56px 28px 34px;
    display: flex;
    justify-content: space-between;
    gap: 30px;
  }

  .footer h2 {
    font-size: 44px;
    letter-spacing: -0.05em;
  }

  .footer p {
    color: rgba(255, 255, 255, 0.65);
    font-size: 12px;
  }

  .footer-links {
    display: flex;
    gap: 22px;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.1em;
    align-items: end;
  }

  @media (max-width: 720px) {


    .hero {
      padding: 48px 18px 40px;
      display: block;
    }


    .hero-art {
      margin-top: 34px;
      min-height: 250px;
    }

    .next-inner {
      padding: 22px 18px;
      grid-template-columns: 1fr;
    }

    .next strong {
      font-size: 24px;
    }

    .section {
      padding: 62px 18px;
    }

    .section-head {
      display: block;
    }

    .more {
      display: inline-block;
      margin-top: 16px;
    }

    .news {
      grid-template-columns: 1fr;
    }

    .news-card {
      min-height: 190px;
    }


    .footer-inner {
      padding: 44px 18px 28px;
      display: block;
    }

    .footer-links {
      margin-top: 30px;
      flex-wrap: wrap;
    }
  }

  .hero-art img {
    display: block;
    width: 100%;
    height: 160px;
    object-fit: cover;
    object-position: center;
  }

</style>
