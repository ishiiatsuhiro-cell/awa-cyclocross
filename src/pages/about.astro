  }

  .subtitle {
    margin-top: 8px;
    color: #666;
  }

  section {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid #d8d9d2;
  }

  h2 {
    font-size: 22px;
    margin-bottom: 20px;
  }

  p {
    line-height: 1.9;
  }

.race-flow {
  padding-left: 28px;
  margin: 24px 0;
}

.race-flow li {
  margin-bottom: 24px;
  padding-left: 8px;
}

.race-flow li::marker {
  color: #245a69;
  font-weight: bold;
}

