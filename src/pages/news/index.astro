---
import { client } from '../../lib/microcms';
import '../../styles/global.css';

type News = {
  id: string;
  title: string;
  date: string;
  category: string | string[];
};

const news = await client.getAllContents<News>({
  endpoint: 'news',
});

news.sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

const formatDate = (date: string) =>
  new Date(date)
    .toLocaleDateString('ja-JP', {
      timeZone: 'Asia/Tokyo',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    })
    .replaceAll('/', '.');
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NEWS | AWA CYCLOCROSS</title>
    <style>
      :global(body) {
        margin: 0;
        background: #f5f3ec;
        color: #173f46;
        font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
      }

      main {
        max-width: 900px;
        margin: 0 auto;
        padding: 64px 24px 120px;
      }

      h1 {
        font-size: clamp(40px, 7vw, 72px);
        margin: 0 0 40px;
      }

      .news-item {
        border-top: 1px solid #b9c7c3;
        padding: 24px 0;
      }

      .news-date {
        font-size: 14px;
        color: #2f6f78;
      }

      .news-category {
        margin-left: 16px;
        font-size: 12px;
        font-weight: bold;
        color: #6a805c;
      }

      .news-title {
        display: block;
        margin-top: 12px;
        font-size: 20px;
        font-weight: 700;
        color: #173f46;
        text-decoration: none;
      }

      .news-title:hover {
        color: #2f6f78;
      }

      .back {
        display: inline-block;
        margin-bottom: 24px;
        color: #2f6f78;
        text-decoration: none;
      }
    </style>
  </head>

  <body>
<header class="header">
  <nav class="nav">
    <a class="brand" href="/">
      <span class="mark">AWA</span>
      <span>AWA CYCLOCROSS</span>
    </a>

    <div class="navlinks">
      <a href="/race">RACE</a>
      <a href="/about">ABOUT CX</a>
      <a href="/news">NEWS</a>
      <a href="/race#entry">ENTRY</a>
    </div>
  </nav>
</header>

    <main>
      <a href="/" class="back">← TOPに戻る</a>
      <h1>NEWS</h1>

      {news.map((item) => (
        <article class="news-item">
          <span class="news-date">{formatDate(item.date)}</span>
          <span class="news-category">
            {Array.isArray(item.category) ? item.category.join(', ') : item.category}
          </span>
          <a class="news-title" href={`/news/${item.id}/`}>
            {item.title}
          </a>
        </article>
      ))}
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <div>
          <h2>AWA CYCLOCROSS</h2>
          <p>© 2026 AWA CYCLOCROSS</p>
        </div>

        <div class="footer-links">
          <a
            href="https://www.facebook.com/awacyclocross?locale=ja_JP"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
          >
            <svg width="20" height="20" viewBox="0 0 24 24"
              fill="currentColor" aria-hidden="true">
              <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.51 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z"/>
            </svg>
            <span>FACEBOOK</span>
          </a>

          <a href="mailto:awacyclocross@gmail.com">
            <svg width="20" height="20" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="1.8"
              stroke-linecap="round" stroke-linejoin="round"
              aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2"/>
              <path d="m3 7 9 6 9-6"/>
            </svg>
            <span>CONTACT</span>
          </a>
        </div>
        </div>
    </footer>
  </body>
</html>