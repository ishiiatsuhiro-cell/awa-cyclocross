---
import { client } from '../../lib/microcms';
import '../../styles/global.css';

type News = {
  id: string;
  title: string;
  date: string;
  category: string;
  body: string;
};

export async function getStaticPaths() {
  const articles = await client.getAllContents<News>({
    endpoint: 'news',
  });

  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{article.title} | AWA CYCLOCROSS</title>
  </head>
  <body>
 
<header class="header">
  <nav class="nav">
    <a class="brand" href="/">
      <span class="mark">AWA</span>
      <span>AWA CYCLOCROSS</span>
    </a>

    <div class="navlinks">
      <a href="/race">RACE</a>
      <a href="/about">ABOUT CX</a>
      <a href="/news">NEWS</a>
      <a href="/race#entry">ENTRY</a>
    </div>
  </nav>
</header>

    <main>
      <p><a href="/news">← NEWS一覧に戻る</a></p>

      <p>
        {new Date(article.date).toLocaleDateString('ja-JP', {
          timeZone: 'Asia/Tokyo',
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
        })}
        ｜ {article.category}
      </p>

      <h1>{article.title}</h1>

      <article set:html={article.body} />
    </main>
        <footer class="footer">
      <div class="footer-inner">
        <div>
          <h2>AWA CYCLOCROSS</h2>
          <p>© 2026 AWA CYCLOCROSS</p>
        </div>

        <div class="footer-links">
          <a
            href="https://www.facebook.com/awacyclocross?locale=ja_JP"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
          >
            <svg width="20" height="20" viewBox="0 0 24 24"
              fill="currentColor" aria-hidden="true">
              <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.51 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z"/>
            </svg>
            <span>FACEBOOK</span>
          </a>

          <a href="mailto:awacyclocross@gmail.com">
            <svg width="20" height="20" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="1.8"
              stroke-linecap="round" stroke-linejoin="round"
              aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2"/>
              <path d="m3 7 9 6 9-6"/>
            </svg>
            <span>CONTACT</span>
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
<style>
  :global(body) {
    margin: 0;
    background: #f5f3ec;
    color: #173f46;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    line-height: 1.8;
  }

  main {
    max-width: 780px;
    margin: 0 auto;
    padding: 80px 24px 120px;
  }

  a {
    color: #2f6f78;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  h1 {
    font-size: clamp(28px, 5vw, 44px);
    line-height: 1.35;
    margin: 24px 0 40px;
    letter-spacing: 0.02em;
  }

  article {
    border-top: 2px solid #173f46;
    padding-top: 32px;
    color: #273e40;
  }

  article :global(img) {
    max-width: 100%;
    height: auto;
  }

.footer .footer-links a {
  color: #ffffff;
}

.footer .footer-links a:hover {
  opacity: 0.7;
  text-decoration: none;
}

</style>